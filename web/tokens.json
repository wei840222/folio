{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Agenfact Dark Cyber UI Design Tokens. High-speed, silicon-dark digital artifact uplink interface with glassmorphic cards, neon accents, and JetBrains Mono typography.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#060913"
      }
    },
    "surface-glass": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#0d1424"
      }
    },
    "cyber-cyan": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#00f2fe"
      }
    },
    "cyber-purple": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#c084fc"
      }
    },
    "cyber-emerald": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#34d399"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#f8fafc"
      }
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#94a3b8"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#64748b"
      }
    },
    "border-cyber": {
      "$value": {
        "colorSpace": "srgb",
        "hex": "#00f2fe"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "compact": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "default": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "group": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "roomy": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono, ui-monospace, monospace",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono, ui-monospace, monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "InterVariable, Inter, ui-sans-serif, system-ui, sans-serif",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
