# Agenfact runtime config example
# Copy to .env and adapt values for your environment.

# Core
AGENFACT_WEB_PATH=./web/dist
AGENFACT_UPLOADS_PATH=./uploads

# Cloudflare Access private file auth
AGENFACT_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
AGENFACT_CF_ACCESS_AUD=<your-access-audience>
# Optional override; default is ${AGENFACT_CF_ACCESS_ISSUER}/cdn-cgi/access/certs
AGENFACT_CF_ACCESS_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs

# Optional allowlists (comma-separated)
AGENFACT_CF_ACCESS_ALLOWED_EMAILS=alice@example.com,bob@example.com
AGENFACT_CF_ACCESS_ALLOWED_GROUPS=agenfact-admins,agenfact-readers

# Optional local/dev testing verifier mode (HS256)
# Do NOT enable in production unless explicitly intended.
# AGENFACT_CF_ACCESS_HS256_SECRET=replace-with-dev-secret
